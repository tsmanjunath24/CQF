# ---------------------------------------------------------------
# Kraken Pro API credentials
# Generate at: https://www.kraken.com/u/security/api
# Required permissions: Query Funds, Query Open Orders, Create & Modify Orders
# ---------------------------------------------------------------
KRAKEN_API_KEY=your_api_key_here
KRAKEN_API_SECRET=your_base64_encoded_private_key_here

# ---------------------------------------------------------------
# Trade parameters
# ---------------------------------------------------------------
# Monthly GBP amount to invest in Bitcoin
DCA_AMOUNT_GBP=100

# Kraken trading pair (XXBTZGBP = BTC/GBP)
KRAKEN_PAIR=XXBTZGBP

# Limit price offset above best ask (0.001 = 0.1%)
# Keeps the order near the top of the book for fast fills while
# still qualifying for the maker fee tier (0.16% vs 0.26% taker)
LIMIT_OFFSET_PCT=0.001

# Cancel limit order and fall back to market order after this many minutes
ORDER_TIMEOUT_MINUTES=30

# ---------------------------------------------------------------
# AWS SES email notifications
# Both addresses must be verified in SES (or use a verified domain)
# ---------------------------------------------------------------
SES_SENDER_EMAIL=dca-bot@yourdomain.com
SES_RECIPIENT_EMAIL=you@yourdomain.com

# AWS region where SES is configured (eu-west-1 covers Ireland / UK)
AWS_REGION=eu-west-2

# ---------------------------------------------------------------
# Safety switch — set to true to simulate without placing orders
# ---------------------------------------------------------------
DRY_RUN=false
